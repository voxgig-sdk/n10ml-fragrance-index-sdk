# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 1
  metrics: count: path: 8
  metrics: count: method: 8

  entity: n10_ml_fragrance_index: {
    path: "/api/v1/alternatives": {
      op: list: method: *GET
    }
    path: "/api/v1/guides": {
      op: list: method: *GET
      op: list: transform: res: *("`body.guides`")|top
    }
    path: "/api/v1/houses": {
      op: list: method: *GET
      op: list: transform: res: *("`body.houses`")|top
    }
    path: "/api/v1/houses/{id}": {
      op: load: method: *GET
    }
    path: "/api/v1/notes/{id}": {
      op: load: method: *GET
    }
    path: "/api/v1/perfumes": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/api/v1/perfumes/{id}": {
      op: load: method: *GET
    }
    path: "/api/v1/similar": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
  }

}